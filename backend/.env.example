# =============================================================================
# AquaSwift Backend — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# ---- Application ----
APP_NAME=AquaSwift
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://aquaswift:aquaswift_dev@db:5432/aquaswift
DATABASE_ECHO=false

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Security ----
JWT_SECRET_KEY=change-me-to-a-secure-random-string-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ---- OTP ----
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_MINUTE=5

# ---- Pagination ----
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- MSG91 (SMS/OTP) ----
MSG91_AUTH_KEY=
MSG91_SENDER_ID=AQUASW
MSG91_OTP_TEMPLATE_ID=

# ---- Firebase (Push) ----
GOOGLE_APPLICATION_CREDENTIALS=
FCM_PROJECT_ID=

# ---- Google Maps ----
GOOGLE_MAPS_API_KEY=

# ---- Email (SendGrid) ----
SENDGRID_API_KEY=
EMAIL_FROM=noreply@aquaswift.in
EMAIL_FROM_NAME=AquaSwift

# ---- AWS S3 ----
AWS_S3_BUCKET=aquaswift-media-dev
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Celery ----
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
